renderName = "cdtorps.render"

xplGround = ""//"xstfgnd"
xplVehicle = "XBHXPL_s"
xplBuilding = "XBHXPL_s"

ammoCost = 20
lifeSpan = 13 
shotSpeed = 400.0

damageValue(N) = 1800 // none
damageValue(L) = 1500 // light
damageValue(H) = 1000 // heavy

damageValue(S) = 1500 // standard
damageValue(D) = 1700 // deflection
damageValue(A) = 1400 // absorbtion

[MissileClass]
omegaTurn = 0.3//0.4
accelThrust = 50.0
velocForward = 500

omegaWaver = 0.1//0.2
rateWaver = 0.1 //2.0
delayTime = 0.15		// homing delay time (zero turn rate)
rampTime = 4			// homing ramp time (from zero to full turn rate)

TeamFilter = 3

[ThermalMissileClass]
coneAngle = 0.4
lockrange = 1500

