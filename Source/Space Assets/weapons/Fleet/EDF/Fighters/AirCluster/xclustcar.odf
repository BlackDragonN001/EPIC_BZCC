[ExplosionClass]
classLabel = "explosion"

particleTypes = 6
particleClass1 = "xclustcar.core"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"
particleClass2 = "xclustcar.puff"
particleCount2 = 20
particleVeloc2 = "15 15 15"
particleClass3 = "xclustcar.light"
particleCount3 = 1
particleVeloc3 = "0.0 0.0 0.0"
//particleClass4 = "xclustcar.Shock"
particleCount4 = 1
particleVeloc4 = "0.0 0.0 0.0"

particleClass5 = "spdebris.scloud1"
particleCount5 = 2
particleVeloc5 = "15.0 15.0 15.0"

//particleClass6 = "spdebris.scloud2"
particleCount6 = 3
particleVeloc6 = "20.0 20.0 20.0"

explSound = "xsv2.wav"

damageRadius = 5.0

damageValue(N) = 75 // none
damageValue(L) = 75 // light
damageValue(H) = 75 // heavy

damageValue(S) = 60 // standard
damageValue(D) = 75 // deflection
damageValue(A) = 35 // absorbtion


[Core]
