[ExplosionClass]
classLabel = "explosion"

particleTypes = 7

particleClass2 = "ixsmiss_aB.CLOUD"
particleCount2 = 1
particleVeloc2 = "0.0 0.0 0.0"

particleClass3 = "ixsmiss_aB.SPARKS"
particleCount3 = 1
particleVeloc3 = "0 0 0"

particleClass4 = "ixsmiss_aB.SPARK"
particleCount4 = 1
particleVeloc4 = "0 0 0"

particleClass1 = "ixsmiss_aB.light"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"

particleClass5 = "ixsmiss_aB.flame"
particleCount5 = 1
particleVeloc5 = "0.0 0.0 0.0"

particleClass7 = "spdebris.scloud1"
particleCount7 = 2
particleVeloc7 = "45.0 45.0 45.0"

particleClass6 = "spdebris.scloud2"
particleCount6 = 3
particleVeloc6 = "60.0 60.0 60.0"

explSound = "xsv2.wav"

damageRadius = 20.0

damageValue(N) = 100 // none
damageValue(L) = 60 // light
damageValue(H) = 20 // heavy

damageValue(S) = 60 // standard
damageValue(D) = 100 // deflections
damageValue(A) = 20 // absorbtion

kickRadius = 20.0
kickOmega = 2.0
kickVeloc = 4.0


[spark]
simulateBase = "sim_smoke"
lifeTime = 0.6
renderBase = "draw_sprite"
spriteCenter.x = 0.0
spriteCenter.y = 0.0
textureName = "sfirecld2.tga"//"ssparks.tga"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "255 250 200 250"
finishColor = "55 20 0 0"
startRadius = 5
finishRadius = 15
animateTime = 0.6


[sparks]
simulateBase = "sim_smoke"
lifeTime = 0.8
renderBase = "draw_sprite"
spriteCenter.x = 0.0
spriteCenter.y = 0.0
textureName = "ssparks.tga"
textureBlend = "one one modulate"//"srcalpha invsrcalpha modulatealpha"
startColor = "255 250 200 255"
finishColor = "55 20 0 0"
startRadius = 2
finishRadius = 19
animateTime = 0.8

[cloud]
simulateBase = "sim_smoke"
