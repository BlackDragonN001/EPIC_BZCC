[OrdnanceClass]
classLabel = "thermalmissile"
shotGeometry = "iorckt00.xsi"
shotSound = "Ordin_b.wav"

xplGround = "null"
xplVehicle = "Xitorps_f"
xplBuilding = "Xitorps_f"
xplExpire = "xplascar_cb"

renderName = "sprocket_f.render"

ammoCost = 20
lifeSpan = 12.0 // 800m
shotSpeed = 300.0

damageValue(N) = 1000 // none
damageValue(L) = 600 // light
damageValue(H) = 200 // heavy

damageValue(S) = 600 // standard
damageValue(D) = 800 // deflection
damageValue(A) = 300 // absorbtion

[MissileClass]
omegaTurn = 0.3//0.4
accelThrust = 50.0
velocForward = 350

omegaWaver = 0.3//0.2
rateWaver = 1.0 //2.0
delayTime = 0.15		// homing delay time (zero turn rate)
rampTime = 3			// homing ramp time (from zero to full turn rate)
avoidRange = 100.0		// terrain obstacle-avoidance range
avoidStrength = 5.0
TeamFilter = 3

[ThermalMissileClass]
coneAngle = 0.4
//lockrange = 3000

[Render]
