[OrdnanceClass]
classLabel = "imagemissile"
shotGeometry = "sgmloc00.xsi"
shotSound = "smort03.wav"

xplGround = "xmslcar"
xplVehicle = "xmslcar"
xplBuilding = "xmslbld"
xplexpire = "xmslcar"

renderName = "locker_as.render"

ammoCost = 150
lifeSpan = 9.0 // 800m
shotSpeed = 300.0

damageValue(N) = 1500 // none
