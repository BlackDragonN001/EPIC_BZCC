damageValue(H) = 1250 // heavy

damageValue(S) = 1350 // standard
damageValue(D) = 1250 // deflection
damageValue(A) = 1500 // absorbtion

[MissileClass]
omegaTurn = 1.0 //1.5
omegaWaver = 2.0//0.2
rateWaver = 2.0 //2.0
delayTime = 1		// homing delay time (zero turn rate)
rampTime = 1			// homing ramp time (from zero to full turn rate)
avoidRange = 200.0		// terrain obstacle-avoidance range
avoidStrength = 15.0
TeamFilter = 3

[Render]
maxdist = 100000
renderBase = "draw_multi"
renderCount = 3
