renderName = "sprocketab.render"

xplGround = "xmortgnd_b"
xplVehicle = "xsprocketa"
xplBuilding = "xsprocketa"

ammoCost = 800
lifeSpan = 6 // 250m
shotSpeed = 280.0

damageValue(N) = 1000 // none
