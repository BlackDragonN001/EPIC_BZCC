[OrdnanceClass]
classLabel = "imagemissile"
shotGeometry = "iorckt00.xsi"
shotSound = "Ordin_b.wav"

xplGround = "null"
xplVehicle = "xbhxpl_s"
xplBuilding = "xbhxpl_s"
xplExpire = "xplascar_cb"

renderName = "sprocket_f.render"

ammoCost = 20
lifeSpan = 12.0 // 800m
shotSpeed = 300.0

damageValue(N) = 500 // none
damageValue(L) = 300 // light
damageValue(H) = 150 // heavy

damageValue(S) = 300 // standard
damageValue(D) = 500 // deflection
damageValue(A) = 200 // absorbtion

[MissileClass]
omegaTurn = 0.5
accelThrust = 50.0
velocForward = 400

omegaWaver = 0.3//0.2
rateWaver = 1.0 //2.0
delayTime = 0.15		// homing delay time (zero turn rate)
rampTime = 3			// homing ramp time (from zero to full turn rate)
avoidRange = 100.0		// terrain obstacle-avoidance range
avoidStrength = 5.0
TeamFilter = 3

[Render]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "sprocket_f.flare"
renderName2 = "sprocket_f.exhaust"
renderName3 = "sprocket_f.flame"
renderName4 = "sprocket_f.trail"

[Flare]
renderBase = "draw_sprite"
textureName = "slightflare.tga"//lightflare.tga
textureBlend = "one one modulate"
startColor = "255 255 255 255"
finishColor = "255 255 255 255"
startRadius = 4.0
finishRadius = 4.0

[exhaust]
renderBase = "draw_trail"
textureName = "wingtrail.tga"//"tflame3.tga"
textureBlend = "one one modulate"
textureRate = 0.05 //.05
startColor = "255 255 255 255"
finishColor = "0 150 255 0"
startRadius = 1.4
finishRadius = 2.4
segmentTime = 0.25
animateTime = 0.2

//[Flame]
