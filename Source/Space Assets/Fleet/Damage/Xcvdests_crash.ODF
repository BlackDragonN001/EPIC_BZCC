particleClass6 = "xcvdests_crash.shocks"
particleCount6 = 1
particleVeloc6 = "0.0 0.0 0.0"

particleClass7 = "xcvdests_crash.shocks2"
particleCount7 = 1
particleVeloc7 = "0.0 0.0 0.0"

particleClass8 = "xcvdests_crash.shocks3"
particleCount8 = 1
