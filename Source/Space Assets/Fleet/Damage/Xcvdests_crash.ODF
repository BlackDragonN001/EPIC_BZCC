particleClass2 = "xcvdests_crash.light"
particleCount2 = 1
particleVeloc2 = "0.0 0.0 0.0"

particleClass3 = "xcvdests_crash.debris1"
particleCount3 = 1
particleVeloc3 = "0.0 0.0 0.0"

particleClass4 = "xcvdests_crash.debris2"
particleCount4 = 1
particleVeloc4 = "0.0 0.0 0.0"

particleClass5 = "xcvdests_crash.debris3"
particleCount5 = 1
particleVeloc5 = "0.0 0.000 0.0"
