///////////////////////////////

explSound = "mort02.wav"
damageRadius = 480.0

damageValue(N) = 200 // none
damageValue(L) = 100 // light
damageValue(H) = 50 // heavy

damageValue(S) = 100 // standard
damageValue(D) = 200 // deflection
damageValue(A) = 50 // absorbtion

kickRadius = 480.0
kickVeloc = 50.0
kickOmega = 1.0

///////////////////////////////

[Shock]
maxdist = 100000
simulateBase = "sim_smoke"
lifeTime = 0.1
renderBase = "draw_emit"
emitName = "xcvdests.shockemit"
emitDelay = 0.1
emitVelocity = "0.0 0 0.0"
emitVariance = "0.0 0.0 0.0"

[Shockemit]
maxdist = 100000
simulateBase = "sim_smoke"
lifeTime = 0.5
renderBase = "draw_sphere"
textureName = "fogring.tga"
textureBlend = "one one modulate"
startColor = "55 55 255 90"
finishColor = "55 55 255 0"
startRadius = 3.0
finishRadius = 980.0
animateTime = 0.5
latitudeBands = 8
longitudeSegments = 16

