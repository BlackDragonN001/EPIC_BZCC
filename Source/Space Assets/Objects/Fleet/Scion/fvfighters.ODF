[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = 55.0 // minimum velocity
velocSet(M) = 105.0 // cruising velocity
velocSet(H) = 320.0 // maximum velocity
accelThrust = 50.0 // thrust acceleration
accelBrake = 50.0 // brake acceleration
accelDrag = 45//10.0 // drag acceleration
omegaSteer(L) = 3//4.51 // steer turn rate at minimum
omegaSteer(M) = 2//2.52 // steer turn rate at cruising
omegaSteer(H) = 1//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 5.0 // steering angular acceleration
alphaStrafe = 0.0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 3.0 // 10 leveling angular acceleration
alphaDamp = 10.0 // 5 damping angular acceleration
pitchPitch = 3.5 //0.5 // maximum pitch angle
rollSteer = 1.6 //0.7 // maximum roll angle from steering
rollStrafe = 3.5 // maximum roll angle from airbraking
timeDeploy = 30 // time to deploy
timeUndeploy = 30 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 7700
AILiftSpring = 25.0
LiftSpring = 12.5 

soundThrust = "lowamb.wav"
soundTurbo = "lowamb.wav"


