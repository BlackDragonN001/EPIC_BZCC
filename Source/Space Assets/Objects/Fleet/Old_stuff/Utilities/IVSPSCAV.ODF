[trail]
renderBase = "draw_multi"
renderCount = 1
renderName1 = "ivspbombsa.trailer"
//renderName2 = "ivspbombsa.flame"

[trailer]
renderBase = "draw_trail"
textureName = "strail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "100 200 255 255"
finishColor = "0 0 255 0"
