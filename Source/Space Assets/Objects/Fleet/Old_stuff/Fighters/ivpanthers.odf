[HoverCraftClass]
velocForward = 320 // []
velocReverse = 150.0 // []
velocStrafe = 70.0 // []
accelThrust = 50.0 //acceleration []
accelDragStop = 10.0 //how fast it stops once hands are off controls []
accelJump = -100.0 // []

setAltitude = 86.0 // how high off the ground

alphaTrack = 14.0 //springs speed it rights itself []
alphaDamp = 15.0 //shocks []

pitchPitch = 2 //nose up []
pitchThrust = 0.0 //nose down []

rollStrafe = 0.44 //rolls while strafing []
omegaSpin = 4.5 //spinning in place speed []
omegaTurn = 2.5 //turning while moving speed []
alphaSteer = 5.0 //how fast it responds to steering []
rollSteer = 0.6 //rolls while steering []


soundThrust = "itank01e.wav"
soundTurbo = "avtanke3.wav"


////////////////////////////

[trail]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "ivpantherg.trailer"
renderName2 = "ivpantherg.flame"

[trailer]
renderBase = "draw_trail"
textureName = "trail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "100 200 255 255"
finishColor = "0 0 255 0"
startRadius = 0.3
finishRadius = 0.7
segmentTime = 3.0
animateTime = 0.3

[flame]
renderBase = "draw_trail"
textureName = "tflame.tga"
textureBlend = "one one modulate"
textureRate = 0.05 //.05
startColor = "255 255 255 255"
finishColor = "255 255 255 0"
startRadius = 1.0
finishRadius = 1.0
segmentTime = 0.03
animateTime = 0.05

[light]
simulateBase = "sim_null"
lifeTime = 1e30
renderBase = "draw_light"
startColor = "20 20 200 400"
finishColor = "20 20 200 400"
startRadius = 10.0
finishRadius = 10.0
animateTime = 1e30
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0

[Lod1]
geometryName = "iocmet00.xsi" ;geometry for lod1
distance = 1200                 ;...distance over this many meters => switch to lod2






