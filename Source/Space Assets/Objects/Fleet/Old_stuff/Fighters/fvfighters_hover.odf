velocReverse = 100.0 // []
velocStrafe = 60.0 // []
accelThrust = 35.0 //acceleration []
accelDragStop = 7.0 //how fast it stops once hands are off controls []
accelJump = -100.0 // []

setAltitude = 65.0 // how high off the ground

alphaTrack = 14.0 //springs speed it rights itself []
alphaDamp = 15.0 //shocks []

pitchPitch = 2 //nose up []
pitchThrust = 0.0 //nose down []

rollStrafe = 0.22 //rolls while strafing []
omegaSpin = 3.5 //spinning in place speed []
omegaTurn = 2.5 //turning while moving speed []
alphaSteer = 4.0 //how fast it responds to steering []
rollSteer = 0.4 //rolls while steering []

soundThrust = "itank01e.wav"
soundTurbo = "avtanke3.wav"



////////////////////////////

[trail]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "fvfighters.trailer"
renderName2 = "fvskys.light"

[trailer]
renderBase = "draw_trail"
textureName = "strail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "250 240 100 255"
finishColor = "250 200 80 0"
startRadius = 0.6
finishRadius = 1.2
segmentTime = 3.0
animateTime = 0.3

[flame]
renderBase = "draw_trail"
textureName = "tflame.tga"
textureBlend = "one one modulate"
textureRate = 0.05 //.05
startColor = "255 255 255 255"
finishColor = "255 255 255 0"
startRadius = 1.0
finishRadius = 1.0
segmentTime = 0.03
animateTime = 0.05

[light]
simulateBase = "sim_null"
lifeTime = 1e30
renderBase = "draw_light"
startColor = "255 255 200 850"
finishColor = "250 250 100 850"
startRadius = 45.0
finishRadius = 45.0
animateTime = 1e30
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0

[Lod1]
geometryName = "iocmet00.xsi" ;geometry for lod1
distance = 1200                 ;...distance over this many meters => switch to lod2





