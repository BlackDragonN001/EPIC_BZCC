[trail]
maxdist = 100000
renderBase = "draw_multi"
renderCount = 3
renderName1 = "ivfighters.trailer"
renderName2 = "ivfighters.flame"
renderName3 = "ivfighters.Light1"


[trailer]
maxdist = 100000
renderBase = "draw_trail"
textureName = "sptrail1.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "150 220 255 100"
finishColor = "0 0 255 0"
startRadius = 0.5
finishRadius = 0.3
segmentTime = 3.0
animateTime = 0.3

[flame]
maxdist = 100000
renderBase = "draw_trail"
textureName = "strail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "200 200 255 180"
finishColor = "0 100 255 0"
startRadius = 1.5
finishRadius = 0.3
segmentTime = 0.5
animateTime = 0.3

[Light1]
maxdist = 100000
renderBase = "draw_sprite"
textureName = "lightflare.tga"
textureBlend = "one one modulate"
startColor = "255 255 255 255"
finishColor = "150 200 255 255"
startRadius = 4.0
finishRadius = 4.0
rotationRate = 10.0

[light]
maxdist = 100000
simulateBase = "sim_null"
lifeTime = 1e30
renderBase = "draw_light"
startColor = "20 255 20 250"
finishColor = "20 255 20 250"
startRadius = 5.0
finishRadius = 5.0
animateTime = 1e30
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0

