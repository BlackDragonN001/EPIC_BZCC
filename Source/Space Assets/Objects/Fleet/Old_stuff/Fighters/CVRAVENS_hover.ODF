[HoverCraftClass]
velocForward = 240 // []
velocReverse = 100.0 // []
velocStrafe = 60.0 // []
accelThrust = 35.0 //acceleration []
accelDragStop = 7.0 //how fast it stops once hands are off controls []
accelJump = -100.0 // []

setAltitude = 61.0 // how high off the ground

alphaTrack = 14.0 //springs speed it rights itself []
alphaDamp = 15.0 //shocks []

pitchPitch = 0.7 //nose up []
pitchThrust = 0.0 //nose down []

rollStrafe = 0.22 //rolls while strafing []
omegaSpin = 3.5 //spinning in place speed []
omegaTurn = 2.5 //turning while moving speed []
alphaSteer = 4.0 //how fast it responds to steering []
rollSteer = 0.4 //rolls while steering []

soundThrust = "itank01e.wav"
soundTurbo = "avtanke3.wav"




////////////////////////////

[trail]
renderBase = "draw_multi"
renderCount = 3
renderName1 = "ivravens.trailer"
//renderName2 = "ivspbombsa.flame"
renderName2 = "sprocketa.trailer"
//renderName2 = "sprocketa.flame"
//renderName3 = "sprocketa.Light1"
renderName3 = "cvtalons.light"

[trailer]
renderBase = "draw_trail"
textureName = "strail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "200 20 255 255"
finishColor = "100 0 255 0"
startRadius = 2
finishRadius = 1
segmentTime = 3.0
animateTime = 0.3

//[flame]
renderBase = "draw_trail"
textureName = "tflame.tga"
textureBlend = "one one modulate"
textureRate = 0.05 //.05
startColor = "255 255 255 255"
finishColor = "255 255 255 0"
startRadius = 1.0
finishRadius = 1.0
segmentTime = 0.03
animateTime = 0.05

[light]
simulateBase = "sim_null"
lifeTime = 1e30
renderBase = "draw_light"
startColor = "20 20 255 850"
finishColor = "20 20 255 850"
startRadius = 45.0
finishRadius = 45.0
animateTime = 1e30
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0


[Lod1]
geometryName = "cvraven_L1.xsi" ;geometry for lod1
geometryScale = 1.5
distance = 1200                 ;...distance over this many meters => switch to lod2




