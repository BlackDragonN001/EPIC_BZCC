////////////////////////////

[trail]
renderBase = "draw_multi"
renderCount = 3
renderName1 = "fvspbombs.trailer"
renderName2 = "fvspbombs.flame
renderName3 = "fvspbombs.light"

[trailer]
renderBase = "draw_trail"
textureName = "sptrail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "250 240 100 255"
finishColor = "250 200 80 0"
startRadius = 0.6
finishRadius = 1
segmentTime = 3.0
animateTime = 0.3

[flame]
renderBase = "draw_trail"
textureName = "tflame.tga"
textureBlend = "one one modulate"
textureRate = 0.05 //.05
startColor = "255 255 255 255"
finishColor = "255 255 255 0"
startRadius = 1.2
finishRadius = 1.2
segmentTime = 0.03
animateTime = 0.05

[light]
renderBase = "draw_sprite"
textureName = "lightflare.tga"
textureBlend = "one one modulate"
startColor = "255 255 255 255"
finishColor = "150 200 255 255"
startRadius = 8.0
finishRadius = 8.0
rotationRate = 10.0

[Lod1]
geometryName = "iocmet00.xsi" ;geometry for lod1
distance = 800                 ;...distance over this many meters => switch to lod2
