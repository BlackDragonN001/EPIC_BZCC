[AirCraftClass]
AlwaysDeployed = true
AlwaysUndeployed = false

velocSet(L) = 0.0 // minimum velocity
velocSet(M) = 45.0 // cruising velocity
velocSet(H) = 200.0 // maximum velocity
accelThrust = 30.0 // thrust acceleration
accelBrake = 30.0 // brake acceleration
accelDrag = 20//10.0 // drag acceleration
omegaSteer(L) = 5//4.51 // steer turn rate at minimum
omegaSteer(M) = 4//2.52 // steer turn rate at cruising
omegaSteer(H) = 3//1.59 // steer turn rate at maximum
omegaStrafe(L) = 1.12 // airbrake turn rate at minimum
omegaStrafe(M) = 0.91 // airbrake turn rate at cruising
omegaStrafe(H) = 0.76 // airbrake turn rate at maximum
alphaSteer = 6.0 // steering angular acceleration
alphaStrafe = 8.0 // airbrake angular acceleration
minAltitude = 170.0 // minimum altitude
maxAltitude = 750.0 // maximum altitude
alphaLevel = 2.5 // 10 leveling angular acceleration
alphaDamp = 8.0//4 // 5 damping angular acceleration
pitchPitch = 2.5//1.5//0.7 //0.5 // maximum pitch angle
rollSteer = 1.6 //1 //0.7 // maximum roll angle from steering
rollStrafe = 2 //1 // maximum roll angle from airbraking
timeDeploy = 5 // time to deploy
timeUndeploy = 5 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 450
AILiftSpring = 25.0
LiftSpring = 12.5 


soundBrake = "wmflame.wav"
soundDeploy = "wmflame.wav"
soundUndeploy = "wmflame.wav"


soundThrust = "lowamb.wav"
soundTurbo = "lowamb.wav"


