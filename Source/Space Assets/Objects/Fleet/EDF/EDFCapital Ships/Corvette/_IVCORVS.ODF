[trail]
renderBase = "draw_multi"
renderCount = 3
renderName1 = "ivcorvs.trailer"
renderName2 = "ivcorvs.flame"
renderName3 = "ivcorvs.Light1"


[trailer]
renderBase = "draw_trail"
textureName = "sptrail1.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "150 220 255 150"
finishColor = "0 0 255 0"
startRadius = 1.1
finishRadius = 0.8
segmentTime = 3.0
animateTime = 0.3

[flame]
renderBase = "draw_trail"
textureName = "strail2.tga"
textureBlend = "one one modulate"
textureRate = 0.05
startColor = "200 200 255 255"
finishColor = "0 100 255 0"
startRadius = 4
finishRadius = 0.8
segmentTime = 0.5
animateTime = 0.3

[Light1]
renderBase = "draw_sprite"
textureName = "lightflare.tga"
textureBlend = "one one modulate"
startColor = "255 255 255 255"
finishColor = "150 200 255 255"
startRadius = 7.0
finishRadius = 7.0
rotationRate = 10.0

