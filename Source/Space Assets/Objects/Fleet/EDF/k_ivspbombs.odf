[CraftClass]
//GROUND_ELASTICITY = 2//0.03125
DAMAGE_SCALE = 0.01 //0.05
CanInteractWithTerminal = true 
WeaponsConverge = true
RetargetOnStrafe = true
CollideTerrainSound = "silence.wav"

FireWhenCanHitFriends = false
attackrange = 2800
blastDist = 2800
AttackTaskBlastDist = 2800.0
waitRange = 1500.0

MaxWeaponPitch = 2
MinWeaponPitch = -2

AvoidType = 2 //plan
xplCrash = "ixshipxpl"



LeaveExplodeScorch = false


rangeScan = 5000.0f
periodScan = 2.0f
velocJam = 5.0f
engageRange = 2000
canHunt = 1

AllowLinkWeapons = true
DoWeaponCanHitCheck = true 
OffensiveProcessIsTenacious = 1
OffensiveProcessIsTenaciousAITeam  = 0

AircraftAttackMustDeploy = true
attackTask = "ArcherAttack"
subAttackTask = "ArcherSubAttack" //"AimFireAttack"//"RocketTankAttack"

subAttackClass = "ANS"

ClosestEnemyGoodEyes = yes 

braccelFactor = 0.03
velFactor = 0.7
steerFactor = 1.0
omegaFactor = 0.01
strafeFactor = 0.1

avoidSpeed = 70;
topSpeed = 230;

selectWaitMsg = "ivtank05.wav"
selectAttackMsg = "ivtank02.wav"
selectFollowMsg = "ivtank04.wav"
selectGoMsg = "ivtank04.wav"
selectOtherMsg = "ivtank05.wav"
selectReadyMsg = "bombcomplete.wav"

holdMsg = "ivtank12.wav"

goMsg = "ivtank04.wav"
attackMsg = "ivtank06.wav"
followMeMsg = "ivtank08.wav"
followMsg = "ivtank03.wav"
repairMsg = "ivtank09.wav"
reloadMsg = "ivtank09.wav"
rescueMsg = "ivtank10.wav"
recycleMsg = "ivtank11.wav"
otherMsg = "ivtank05.wav" 
holdMsg = "ivtank12.wav"
user1Msg = ""  
killedMsg = "ivtank07.wav"
diedMsg = "Bomberlost.wav"

[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = 50.0 // minimum velocity
velocSet(M) = 85.0 // cruising velocity
velocSet(H) = 230.0 // maximum velocity
accelThrust = 40.0 // thrust acceleration
accelBrake = 40.0 // brake acceleration
accelDrag = 40//10.0 // drag acceleration
omegaSteer(L) = 3//4.51 // steer turn rate at minimum
omegaSteer(M) = 2//2.52 // steer turn rate at cruising
omegaSteer(H) = 1//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 5.0 // steering angular acceleration
alphaStrafe = 8.0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 1.5 // 10 leveling angular acceleration
alphaDamp = 10.0//4 // 5 damping angular acceleration
pitchPitch = 3.5//1.5//0.7 //0.5 // maximum pitch angle
rollSteer = 1.2 //1 //0.7 // maximum roll angle from steering
rollStrafe = 3.6 //1 // maximum roll angle from airbraking
timeDeploy = 30 // time to deploy
timeUndeploy = 30 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 7900
AILiftSpring = 20.0
LiftSpring = 20 

soundThrust = "itank01e.wav"
soundTurbo = "avtanke3.wav"


