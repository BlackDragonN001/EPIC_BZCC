[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = -20.0 // minimum velocity
velocSet(M) = 0.0 // cruising velocity
velocSet(H) = 300.0 // maximum velocity
accelThrust = 50.0 // thrust acceleration
accelBrake = 20.0 // brake acceleration
accelDrag = 35//10.0 // drag acceleration
omegaSteer(L) = 3//4.51 // steer turn rate at minimum
omegaSteer(M) = 2//2.52 // steer turn rate at cruising
omegaSteer(H) = 1//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 4.0 // steering angular acceleration
alphaStrafe = 8.0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 2.5 // 10 leveling angular acceleration
alphaDamp = 10.0//4 // 5 damping angular acceleration
pitchPitch = 3.5//1.5//0.7 //0.5 // maximum pitch angle
rollSteer = 1.6 //1 //0.7 // maximum roll angle from steering
rollStrafe = 3.5 //1 // maximum roll angle from airbraking
timeDeploy = 10 // time to deploy
timeUndeploy = 10 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true

aiAltitude = 7600
AILiftSpring = 30.0
LiftSpring = 30 


soundBrake = "wmflame.wav"
soundDeploy = "wmflame.wav"
soundUndeploy = "wmflame.wav"


soundThrust = "lowamb.wav"
soundTurbo = "hyper.wav"


