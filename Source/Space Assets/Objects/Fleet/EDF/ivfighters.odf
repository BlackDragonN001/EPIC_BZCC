[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = 60.0 // minimum velocity
velocSet(M) = 125.0 // cruising velocity
velocSet(H) = 350.0 // maximum velocity
accelThrust = 60.0 // thrust acceleration
accelBrake = 60.0 // brake acceleration
accelDrag = 30//10.0 // drag acceleration
omegaSteer(L) = 6//4.51 // steer turn rate at minimum
omegaSteer(M) = 5//2.52 // steer turn rate at cruising
omegaSteer(H) = 4//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 8.0 // steering angular acceleration
alphaStrafe = 0//12.0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 2.5 // 10 leveling angular acceleration
alphaDamp = 8.0//4 // 5 damping angular acceleration
pitchPitch = 3.5//1.5//0.7 //0.5 // maximum pitch angle
rollSteer = 2.6 //1 //0.7 // maximum roll angle from steering
rollStrafe = 4 //1 // maximum roll angle from airbraking
timeDeploy = 30 // time to deploy
timeUndeploy = 30 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 7300
AILiftSpring = 15.0
LiftSpring = 15.0 

soundThrust = "jpack01.wav"
soundBrake = "wmflame.wav"
soundDeploy = "wmflame.wav"
soundUndeploy = "wmflame.wav"
soundTurbo = "avtanke3.wav"


