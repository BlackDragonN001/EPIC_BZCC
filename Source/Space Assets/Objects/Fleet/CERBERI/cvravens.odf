[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = 45.0 // minimum velocity
velocSet(M) = 85.0 // cruising velocity
velocSet(H) = 260.0 // maximum velocity
accelThrust = 35.0 // thrust acceleration
accelBrake = 30.0 // brake acceleration
accelDrag = 25//50//10.0 // drag acceleration
omegaSteer(L) = 2//4.51 // steer turn rate at minimum
omegaSteer(M) = 1//2.52 // steer turn rate at cruising
omegaSteer(H) = 0.5//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 4//8.0 // steering angular acceleration
alphaStrafe = 0.0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 3.0 // leveling angular acceleration
alphaDamp = 10.0 // damping angular acceleration
pitchPitch = 2.5 // maximum pitch angle
rollSteer = 1.4//0.7 // maximum roll angle from steering
rollStrafe = 3.8 // maximum roll angle from airbraking
timeDeploy = 30 // time to deploy
timeUndeploy = 30 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 7280
AILiftSpring = 15.0

soundThrust = "jpack01.wav"
soundBrake = "wmflame.wav"
soundDeploy = "wmflame.wav"
soundUndeploy = "wmflame.wav"
soundTurbo = "avtanke3.wav"




