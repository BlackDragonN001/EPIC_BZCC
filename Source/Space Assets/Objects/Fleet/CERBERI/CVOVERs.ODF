[AirCraftClass]
AlwaysDeployed = true
MaxTakeoffSpeed = 5000.0

velocSet(L) = 35.0 // minimum velocity
velocSet(M) = 85.0 // cruising velocity
velocSet(H) = 160.0 // maximum velocity
accelThrust = 40.0 // thrust acceleration
accelBrake = 40.0 // brake acceleration
accelDrag = 20//50//10.0 // drag acceleration
omegaSteer(L) = 5//4.51 // steer turn rate at minimum
omegaSteer(M) = 4//2.52 // steer turn rate at cruising
omegaSteer(H) = 3//1.59 // steer turn rate at maximum
omegaStrafe(L) = 0 // airbrake turn rate at minimum
omegaStrafe(M) = 0 // airbrake turn rate at cruising
omegaStrafe(H) = 0 // airbrake turn rate at maximum
alphaSteer = 5.0 // steering angular acceleration
alphaStrafe = 0 // airbrake angular acceleration
minAltitude = 4000.0 // minimum altitude
maxAltitude = 10000.0 // maximum altitude
alphaLevel = 2.0 // leveling angular acceleration
alphaDamp = 10.0 // damping angular acceleration
pitchPitch = 3.5 // maximum pitch angle
rollSteer = 1.8//0.7 // maximum roll angle from steering
rollStrafe = 3.8 // maximum roll angle from airbraking
timeDeploy = 15 // time to deploy
timeUndeploy = 15 // time to undeploy

OverWaterFlying = true
OverWaterLanded = true
aiAltitude = 7200
AILiftSpring = 15.0
LiftSpring = 12.5 

soundThrust = "enginetal.wav"
soundTurbo = "enginetal.wav"




